# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL via docker-compose — see DEPLOY.md):
# DATABASE_URL="postgresql://agentstudio:CHANGE_ME@db:5432/agentstudio?schema=public"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth (Clerk) — https://dashboard.clerk.com ──────────────────────────────
# Leave empty to run in demo mode (no login, shared demo workspace).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── AI providers (optional — mock model used when empty) ────────────────────
# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# OpenAI — https://platform.openai.com
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Allow the public landing-page demo to hit real AI providers (default: mock only)
DEMO_USE_REAL_AI="false"

# ── Stripe (prepared, not yet active) ───────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── docker-compose only ─────────────────────────────────────────────────────
POSTGRES_USER="agentstudio"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="agentstudio"
